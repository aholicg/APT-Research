---
import type { CollectionEntry } from "astro:content";
import Icon from "./Icon.astro";

interface Props {
  note: CollectionEntry<"notes">;
  index: number;
  featured?: boolean;
}

const { note, index, featured = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = `${base}/notes/${note.id}/`;
const date = note.data.pubDate.toLocaleDateString("en-US", {
  month: "short",
  day: "2-digit",
  year: "numeric",
  timeZone: "UTC",
});
---

<article
  class:list={["note-card", { "note-card--featured": featured }]}
  data-note-card
  data-tags={note.data.tags.join(" ").toLowerCase()}
>
  <a href={href} aria-label={`Read ${note.data.title}`}>
    <span class="note-card__index" aria-hidden="true">
      {String(index + 1).padStart(2, "0")}
    </span>

    <span class="note-card__content">
      <span class="note-card__meta">
        <span><Icon name="calendar" size={13} /> {date}</span>
        <span><Icon name="clock" size={13} /> {note.data.readingTime}</span>
      </span>
      <strong>{note.data.title}</strong>
      <span class="note-card__description">{note.data.description}</span>
      <span class="note-card__tags">
        {note.data.tags.map((tag) => <span>#{tag}</span>)}
      </span>
      <span class="note-card__open">
        <span>Read note</span>
        <Icon name="arrow" size={19} />
      </span>
    </span>
  </a>
</article>
