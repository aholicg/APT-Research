---
interface Props {
  name:
    | "home"
    | "note"
    | "user"
    | "github"
    | "arrow"
    | "calendar"
    | "clock"
    | "tag"
    | "filter"
    | "copy"
    | "close"
    | "menu"
    | "external";
  size?: number;
  strokeWidth?: number;
}

const { name, size = 18, strokeWidth = 1.7 } = Astro.props;
---

<svg
  class="icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    name === "home" && (
      <>
        <path d="m3 11 9-8 9 8" />
        <path d="M5 10v11h14V10" />
        <path d="M9 21v-6h6v6" />
      </>
    )
  }
  {
    name === "note" && (
      <>
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z" />
        <path d="M14 2v6h6M8 13h8M8 17h6" />
      </>
    )
  }
  {
    name === "user" && (
      <>
        <circle cx="12" cy="8" r="4" />
        <path d="M4.5 21a7.5 7.5 0 0 1 15 0" />
      </>
    )
  }
  {
    name === "github" && (
      <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3.28-.36 6.72-1.61 6.72-7.25A5.65 5.65 0 0 0 19.22 3.3 5.2 5.2 0 0 0 19.08 1S17.9.62 15 2.48a13.38 13.38 0 0 0-6 0C6.1.62 4.92 1 4.92 1a5.2 5.2 0 0 0-.14 2.3 5.65 5.65 0 0 0-1.5 3.95c0 5.63 3.44 6.88 6.72 7.25A4.8 4.8 0 0 0 9 18v4M9 19c-3 .92-3-1.5-4-2" />
    )
  }
  {
    name === "arrow" && (
      <>
        <path d="M5 12h14" />
        <path d="m13 6 6 6-6 6" />
      </>
    )
  }
  {
    name === "calendar" && (
      <>
        <rect x="3" y="5" width="18" height="16" rx="2" />
        <path d="M16 3v4M8 3v4M3 10h18" />
      </>
    )
  }
  {
    name === "clock" && (
      <>
        <circle cx="12" cy="12" r="9" />
        <path d="M12 7v5l3 2" />
      </>
    )
  }
  {
    name === "tag" && (
      <>
        <path d="M20.6 13.6 11 4H4v7l9.6 9.6a2 2 0 0 0 2.8 0l4.2-4.2a2 2 0 0 0 0-2.8Z" />
        <circle cx="7.5" cy="7.5" r=".8" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    name === "filter" && (
      <>
        <path d="M4 6h16M7 12h10M10 18h4" />
      </>
    )
  }
  {
    name === "copy" && (
      <>
        <rect x="8" y="8" width="12" height="12" rx="2" />
        <path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" />
      </>
    )
  }
  {
    name === "close" && (
      <>
        <path d="M5 5l14 14M19 5 5 19" />
      </>
    )
  }
  {
    name === "menu" && (
      <>
        <path d="M4 7h16M4 12h16M4 17h16" />
      </>
    )
  }
  {
    name === "external" && (
      <>
        <path d="M14 4h6v6M10 14 20 4" />
        <path d="M20 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h5" />
      </>
    )
  }
</svg>
