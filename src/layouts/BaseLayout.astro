---
import "../styles/global.css";
import Icon from "../components/Icon.astro";

interface Props {
  title?: string;
  description?: string;
  article?: boolean;
}

const {
  title = "Trang's Notes",
  description = "Notes on security, systems, design, and the spaces in between.",
  article = false,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const fullTitle = title === "Trang's Notes" ? title : `${title} — Trang's Notes`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#06100d" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}/assets/favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{fullTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="site-title" href={`${base}/`}>
        <Icon name="note" size={22} />
        <span>Trang's notes</span>
      </a>

      <nav aria-label="Primary navigation">
        <a class="icon-link" href={`${base}/`} aria-label="Home">
          <Icon name="home" />
        </a>
        <a class="icon-link" href={`${base}/#notes`} aria-label="All notes">
          <Icon name="note" />
        </a>
        <span class="nav-divider"></span>
        <a
          class="icon-link"
          href="https://github.com/aholicg"
          target="_blank"
          rel="noreferrer"
          aria-label="GitHub profile"
        >
          <Icon name="github" />
        </a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div>
        <Icon name="note" size={16} />
        <span>Trang's notes</span>
      </div>
      <a href="#top">Back to top ↑</a>
    </footer>
  </body>
</html>
